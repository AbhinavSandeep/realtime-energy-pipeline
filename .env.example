# Copy this file to ".env" and change the passwords before the first start:
#   cp .env.example .env
# ".env" is listed in .gitignore and must never be committed.

# ---- Kafka topics ----
RAW_TOPIC=energy.raw
AGG_TOPIC=energy.aggregated
DLQ_TOPIC=energy.invalid
RAW_PARTITIONS=3
# 7 days
TOPIC_RETENTION_MS=604800000
KAFKA_RETENTION_HOURS=168

# ---- Producer ----
# Source of the UCI data set (downloaded once into ./data if the file is missing)
DATA_URL=https://archive.ics.uci.edu/static/public/235/individual+household+electric+power+consumption.zip
# Event-time seconds replayed per wall-clock second (3600 = 1 hour of data per second = 60 events/s).
# 0 = as fast as possible.
SPEEDUP=3600
# Stop after N events (0 = whole file)
MAX_EVENTS=0
# Share of events that are deliberately delayed to test the watermark
LATE_EVENT_RATE=0.002
LATE_DELAY_MINUTES=5
# Keep watching the file for appended rows after the end is reached
FOLLOW=true
# A producer added to a running stream starts at the current event time
JOIN_STREAM_TIME=true
# Salt for the pseudonymous meter IDs
METER_ID_SALT=change-me-salt

# ---- Spark ----
TRIGGER_SECONDS=5
WATERMARK="10 minutes"
MAX_OFFSETS_PER_TRIGGER=20000
VOLTAGE_MIN=200
VOLTAGE_MAX=260
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g

# ---- TimescaleDB ----
POSTGRES_DB=energy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
# Least-privilege roles created by db/init/01-init.sh
WRITER_USER=spark_writer
WRITER_PASSWORD=change-me-writer
READER_USER=report_reader
READER_PASSWORD=change-me-reader

# ---- API ----
# Leave empty to disable the X-API-Key check
API_KEY=

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, max(max_intensity) AS \"max A\"\nFROM energy.agg_15min WHERE $__timeFilter(window_start) AND meter_id IN (${meter:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sub-meters per 5 min (Wh)",
      "description": "Energy per area of the house.",
      "datasource": {
        "type": "grafana-postgresql-datasource",

          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, sum(energy_kwh) AS \"total kWh\", sum(sub_1_kwh) AS \"kitchen kWh\",\n  sum(sub_2_kwh) AS \"laundry kWh\", sum(sub_3_kwh) AS \"water heater + AC kWh\"\nFROM energy.agg_daily WHERE $__timeFilter(window_start) AND meter_id IN (${meter:sqlstring})\nGROUP BY 1 ORDER BY 1"

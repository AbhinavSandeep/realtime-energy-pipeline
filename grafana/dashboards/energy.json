          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, sum(valid_count) AS \"valid\", sum(invalid_count) AS \"invalid\"\nFROM energy.quality_5min WHERE $__timeFilter(window_start) AND meter_id IN (${meter:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }

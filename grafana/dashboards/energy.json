            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, sum(sum_sub_1_wh) AS \"kitchen\",\n  sum(sum_sub_2_wh) AS \"laundry\", sum(sum_sub_3_wh) AS \"water heater + AC\"\nFROM energy.agg_5min WHERE $__timeFilter(window_start) AND meter_id IN (${meter:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Data quality per 5 min",
      "description": "Invalid readings are also written to topic energy.invalid.",
